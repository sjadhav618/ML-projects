"""
Clinical Trial Data Extractor (WHO Drug to SDTM CM Domain)
----------------------------------------------------------
Hey there! This module takes messy, unstructured clinical trial notes from eCRFs 
and extracts brand-name medications. 

It then uses WHO Drug dictionary concepts to map those trade names to their 
standardized active ingredients and exports everything into a CDISC SDTM-compliant 
CSV file ready for statistical review or regulatory submission.
"""

from typing import List, Optional
import pandas as pd
from pydantic import BaseModel, Field


# ==========================================
# 1. Defining Our Clinical Data Schemas
# ==========================================
# In clinical data management, we need strict validation. These Pydantic models 
# act as our data guardrails, matching the official CDISC SDTM Implementation Guide (v3.4).

class ConcomitantMedicationRecord(BaseModel):
    """Represents a single row in the CDISC SDTM CM (Concomitant Medications) table."""
    STUDYID: str = Field(..., description="Unique Clinical Trial Study ID")
    DOMAIN: str = Field("CM", description="SDTM Domain Code for Concomitant Medications")
    USUBJID: str = Field(..., description="Unique Subject Identifier across the trial")
    CMSEQ: int = Field(..., description="Sequence number of the medication for this subject")
    CMTRT: str = Field(..., description="Reported name of the drug (Verbatim / Brand Name)")
    CMDECOD: str = Field(..., description="Standardized active ingredient name (WHO Drug)")
    CMSTDTC: Optional[str] = Field(None, description="Start date of medication in ISO 8601 format")


class PatientTrialNote(BaseModel):
    """A lightweight container for incoming patient site notes from eCRFs."""
    study_id: str
    usubjid: str
    site_narrative: str
    visit_date: str


# ==========================================
# 2. Medical Coding Lookup Dictionary
# ==========================================
# In a full enterprise application, this would connect to an official WHO Drug database.
# For our pipeline, this mock dictionary translates trade names to standardized generic ingredients.
WHO_DRUG_DICTIONARY = {
    "lipitor": "ATORVASTATIN CALCIUM",
    "glucophage": "METFORMIN HYDROCHLORIDE",
    "humira": "ADALIMUMAB",
    "keytruda": "PEMBROLIZUMAB",
    "synthroid": "LEVOTHYROXINE SODIUM",
    "xanax": "ALPRAZOLAM"
}


# ==========================================
# 3. Core Extraction Engine
# ==========================================
def extract_medications_from_narratives(notes: List[PatientTrialNote]) -> List[ConcomitantMedicationRecord]:
    """
    Scans patient narrative notes, searches for known brand names, 
    and packages them into CDISC-compliant records.
    """
    print(f"🔍 Starting scan across {len(notes)} patient narrative notes...")
    extracted_records = []

    for note in notes:
        text_lower = note.site_narrative.lower()
        medication_sequence = 1  # Tracks drug order (1, 2, 3...) per patient

        # Check the note text against our WHO Drug lookup dictionary
        for brand_name, generic_ingredient in WHO_DRUG_DICTIONARY.items():
            if brand_name in text_lower:
                # Build a standardized SDTM row
                sdtm_row = ConcomitantMedicationRecord(
                    STUDYID=note.study_id,
                    DOMAIN="CM",
                    USUBJID=note.usubjid,
                    CMSEQ=medication_sequence,
                    CMTRT=brand_name.upper(),      # Standard CDISC uppercase convention
                    CMDECOD=generic_ingredient,    # Standardized WHO Drug term
                    CMSTDTC=note.visit_date
                )
                extracted_records.append(sdtm_row)
                medication_sequence += 1

    print(f"Extraction complete! Found {len(extracted_records)} total medication records.")
    return extracted_records


# ==========================================
# 4. Tabular Exporter
# ==========================================
def save_sdtm_to_csv(records: List[ConcomitantMedicationRecord], output_filename: str = "cm_domain.csv") -> pd.DataFrame:
    """
    Takes our validated records, converts them into a pandas DataFrame, 
    and saves them as a clean CSV file.
    """
    # Dump Pydantic objects into standard Python dictionaries
    raw_dicts = [record.model_dump() for record in records]
    
    # Create the DataFrame
    df = pd.DataFrame(raw_dicts)
    
    # Save directly to CSV without row index numbers
    df.to_csv(output_filename, index=False)
    print(f" Exported SDTM CM dataset directly to '{output_filename}'\n")
    return df


# ==========================================
# 5. Let's Run It!
# ==========================================
if __name__ == "__main__":
    # Sample clinical site notes from an eCRF narrative
    sample_notes = [
        PatientTrialNote(
            study_id="STUDY-ONC-2026",
            usubjid="SITE101-SUBJ001",
            site_narrative="Patient presents with controlled hyperlipidemia. Currently taking Lipitor daily.",
            visit_date="2026-10-18"
        ),
        PatientTrialNote(
            study_id="STUDY-ONC-2026",
            usubjid="SITE101-SUBJ002",
            site_narrative="Subject reported joint pain. Notes prior effective trial with Humira.",
            visit_date="2026-10-18"
        ),
        PatientTrialNote(
            study_id="STUDY-ONC-2026",
            usubjid="SITE102-SUBJ005",
            site_narrative="Type 2 diabetes managed on Glucophage. Scheduled to initiate Keytruda today.",
            visit_date="2026-10-19"
        )
    ]

    print("==================================================")
    print("      SDTM-CM Clinical Trial Data Extractor       ")
    print("==================================================\n")

    # Step A: Run Extraction
    sdtm_records = extract_medications_from_narratives(sample_notes)

    # Step B: Export to CSV & Preview Table
    sdtm_df = save_sdtm_to_csv(sdtm_records, output_filename="cm_domain.csv")

    print("--- SDTM CM Table Preview ---")
    print(sdtm_df.to_string(index=False))
